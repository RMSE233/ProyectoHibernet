<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectohibernet.controller.LibroController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1f3a5f;" text="Registro de libros" />

    <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 2);">

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label minWidth="70.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #37474f;" text="Título:" />
            <TextField fx:id="txtTitulo" promptText="Título del libro" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #b0bec5; -fx-padding: 7 10;" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label minWidth="70.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #37474f;" text="Autor:" />
            <TextField fx:id="txtAutor" promptText="Autor del libro" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #b0bec5; -fx-padding: 7 10;" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label minWidth="70.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #37474f;" text="Año:" />
            <TextField fx:id="txtAnio" promptText="Año de publicación" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #b0bec5; -fx-padding: 7 10;" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label minWidth="70.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #37474f;" text="Precio:" />
            <TextField fx:id="txtPrecio" promptText="Precio del libro" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #b0bec5; -fx-padding: 7 10;" HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label minWidth="70.0" prefWidth="70.0" style="-fx-font-weight: bold; -fx-text-fill: #37474f;" text="Categoría:" />
            <ComboBox fx:id="cmbCategoria" promptText="Seleccione una categoría" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #b0bec5; -fx-padding: 3 5;" HBox.hgrow="ALWAYS" />
        </HBox>

    </VBox>

    <HBox spacing="10.0">

        <Button onAction="#guardarLibro" style="-fx-background-color: #2e9e5b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand;" text="Guardar libro" />

        <Button fx:id="btnModificar" disable="true" onAction="#modificarLibro" style="-fx-background-color: #2f80ed; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand;" text="Modificar libro" />

        <Button fx:id="btnEliminar" disable="true" onAction="#eliminarLibro" style="-fx-background-color: #e5484d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand;" text="Eliminar libro" />

        <Button onAction="#cargarLibros" style="-fx-background-color: #8e5bd6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand;" text="Cargar libros" />

        <Button onAction="#limpiarCampos" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand;" text="Limpiar campos" />

    </HBox>

    <TableView fx:id="tblLibros" prefHeight="350.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cfd8dc;" VBox.vgrow="ALWAYS">

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>

        <placeholder>
            <Label style="-fx-text-fill: #78909c;" text="No hay libros registrados" />
        </placeholder>

        <columns>

            <TableColumn fx:id="colId" prefWidth="60.0" style="-fx-alignment: CENTER;" text="ID" />

            <TableColumn fx:id="colTitulo" prefWidth="250.0" text="Título" />

            <TableColumn fx:id="colAutor" prefWidth="220.0" text="Autor" />

            <TableColumn fx:id="colAnio" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Año" />

            <TableColumn fx:id="colPrecio" prefWidth="110.0" style="-fx-alignment: CENTER-RIGHT;" text="Precio" />

            <TableColumn fx:id="colCategoria" prefWidth="150.0" text="Categoría" />

        </columns>

    </TableView>

</VBox>